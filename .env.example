# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/ironvault"

# Secret for signing session JWTs (use a long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Vercel Blob read/write token (auto-set on Vercel, optional for local dev)
BLOB_READ_WRITE_TOKEN=""
